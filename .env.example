# ────────────────────────────────────────────────────────────────
# Language Daily configuration — copy this file to `.env` and fill it in.
#   cp .env.example .env
# Never commit the real .env file (it is git-ignored).
# ────────────────────────────────────────────────────────────────

# --- Languages in the daily document --------------------------------
# nl = Dutch (NOS.nl), ja = Japanese (NHK News Web Easy via nhkeasier.com).
# Comma-separated; the order here is the order inside the Kindle document.
# A run with several languages still produces ONE file and ONE email.
LANGUAGES=nl,ja

# --- Article feeds (optional overrides) -----------------------------
# nl default: https://feeds.nos.nl/nosnieuwsalgemeen
#    other sections: nosnieuwssport, nosnieuwsbinnenland, nosnieuwsbuitenland, ...
# ja default: https://nhkeasier.com/feed/ - a mirror of NHK News Web Easy whose
#    feed carries the COMPLETE easy-Japanese article, furigana for every kanji
#    and a slow-reading mp3, so nothing needs scraping.
#NOS_FEED_URL=https://feeds.nos.nl/nosnieuwssport

# --- LLM provider (writes the English lesson) ---------------------
# Default: Anthropic API. Get a key at https://console.anthropic.com/
#   (API keys -> Create key)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# --- OR use DeepSeek (Anthropic-compatible endpoint) ----------------
# Get a key at https://platform.deepseek.com/ (API keys -> Create key),
# put it in ANTHROPIC_API_KEY, then uncomment the next two lines:
#ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#CLAUDE_MODEL=deepseek-v4-pro      # or deepseek-v4-flash (cheaper/faster)

# --- Gmail sending (used as the "from" address for your Kindle) ---
# Use an App Password, NOT your normal Gmail password. Steps:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Google Account -> Security -> "App passwords" -> create one for Mail.
#   3. Paste the 16-character password here.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Kindle destination ------------------------------------------
# Put YOUR Kindle address here, e.g. yourname@kindle.com.
# Comma-separate to deliver to more than one, e.g. yourname@kindle.com,kpbl@kindle.com.
# Add the Gmail sender below to Amazon's "Approved Personal Document
# E-mail List": amazon.com -> Account -> Content & Devices -> Preferences.
# Tip: you can also use <yourname>@free.kindle.com for Wi-Fi-only delivery.
KINDLE_EMAIL=yourname@kindle.com

# --- Scheduling ----------------------------------------------------
# Anchored to UTC (DeepSeek pricing discounts are UTC-based). Check the
# off-peak window on https://platform.deepseek.com and set DELIVERY_TIME to
# an hour inside it, e.g. 05:00.
TIMEZONE=UTC
DELIVERY_TIME=05:00

# --- Behaviour ------------------------------------------------------
# SEND_EMAIL=false -> build + save preview HTML only (never sends).
SEND_EMAIL=true
# When a feed runs out of unseen articles, skip that language for the day
# (false, default) instead of resending the newest one (true).
ALLOW_REPEATS=false
# Keep articles short for A1 learners & low token cost.
MAX_ARTICLE_CHARS=1700
MAX_VOCAB=12
# Japanese: shorter source text (characters carry more meaning and the
# kana/romaji readings make the generated lesson longer).
MAX_ARTICLE_CHARS_JA=900
MAX_VOCAB_JA=10
